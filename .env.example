# 3OddsWeekend - environment variables. This file has NO real values.
# Copy the names into Vercel (Settings, Environment Variables). Never commit real values.
# Mark the secret ones as Sensitive in Vercel.

# Telegram
TELEGRAM_BOT_TOKEN= # BotFather, your bot, API Token (secret)
TELEGRAM_WEBHOOK_SECRET= # you invent it, 20+ letters and numbers (secret)
TELEGRAM_ADMIN_IDS= # your numeric Telegram ID, comma separated for more
TELEGRAM_GROUP_ID= # paid group ID, starts with -100 (send /groupid in the group)

# Supabase (this bot's own project)
NEXT_PUBLIC_SUPABASE_URL= # Project Settings, API, Project URL
SUPABASE_SECRET_KEY= # Project Settings, API, secret / service_role key (secret)

# Paystack
PAYSTACK_SECRET_KEY= # Settings, API Keys and Webhooks, LIVE secret key (secret)

# Secrets you invent
CRON_SECRET= # used by Vercel's daily cron (secret)
DISPATCH_SECRET= # used in every cron-job.org link and test link (secret)

# Support and AI
SUPPORT_CONTACT= # your support email, shown in /paysupport
GEMINI_API_KEY= # Google AI Studio, free (secret)
GROQ_API_KEY= # Groq console, free (secret)

# Football data
FOOTBALL_DATA_API_TOKEN= # football-data.org account (secret)

# Your Vercel production address, no trailing slash
SITE_URL= # for example https://yourname.vercel.app

# Not used any more (Facebook feature is dead). Leave these out:
# FB_APP_ID, FB_APP_SECRET, FB_PAGE_ID, FB_VERIFY_TOKEN
